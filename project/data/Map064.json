1,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「ご、ごめんなさい、でもすごく似合ってます！可愛い…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「可愛い…最後に言われたのはいつかな」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「さすがに私の中の雌の部分がうずいてくるぞ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ほら、お待ちかねのデカい尻だぞ？もう目が釘付けじゃないか」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_03",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「うわぁ、おっき…本当に可愛いお尻です」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ふっ、だがこのままじゃちんぽが切ないだろ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_01",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ちゃんと自分で腰を動かしてみろ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あっ…わ、分かりました」"]},{"code":108,"indent":0,"parameters":["ゆっくりめなピストン音"]},{"code":250,"indent":0,"parameters":[{"name":"se/Wet_sound/1_slow_piston","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「んっ…なぎさんのお尻、あったかくて張りがあって…あんっ！少しだけ擦れてます…」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_02",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ほらどうした？そんなんじゃ届かないぞ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「念願の尻が目の前にあるんだからしっかり腰を振れよ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_06",0,0,0,0,100,100,255,0]},{"code":108,"indent":0,"parameters":["普通のピストン音"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"se/Wet_sound/2_normal_piston","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「わ、分かりましたぁ…んっ！あっ！くぅ、ズリズリして気持ちい…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「無様な腰振りだな、ちんぽ気持ちよくなりたくて必死だぞ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「だ、だってぇ…んんっ！あっ！ちゃんとこすれてきたぁっ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_04",0,0,0,0,100,100,255,0]},{"code":108,"indent":0,"parameters":["早めのピストン音"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"se/Wet_sound/4_high_piston","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「嬉しそうなマゾだな、ほれ、もう少し頑張れ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あんっ！くぅ…えいっ！えいっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「はは、そんな風に必死だと私も濡れてくるじゃないか」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_05",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あぁんっ！ぐりぐりって…なぎさんのお尻にちんぽ圧迫されてるぅ…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「何甘い雌声出してんだ、キモマゾが」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_04",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「休んでる暇があったら腰振れ、ほら、いっちに、さんっしっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あっ！は、早いぃ…腰振り、ついていけないですぅ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_06",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「なんだ情けない奴だな、もう少しマゾ根性出せ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「仕方ない、いつまでもヘコヘコ尻の下で動かれても迷惑だからな、こうやって…」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_05",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「んんっ！きたぁっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「なぎさんのお尻の割れ目に…ちんぽフィットしてるぅっ！」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_04",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「はは、本当に可愛い奴だ、今日は特別に…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「こうして気持ちよくしてやるよ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_08",0,0,0,0,100,100,255,0]},{"code":108,"indent":0,"parameters":["早めのピストン音"]},{"code":251,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"se/Wet_sound/4_high_piston","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「私を選んでくれたお礼だ、ぐりぐりって上下に擦ってやる」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あっ！うぐぅ…すごい…裏筋刺激されてるぅ…！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「1日中動いてた蒸れ蒸れの尻だぞ？」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_07",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「そうだな…もう少し頑張ったら今度は私のパンツを被せながら生尻コキでもしてやるか」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「うぅ…嬉しくて感動します…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ふっ、本当に可愛らしいマゾだな」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ほれ、もう少し頑張れよ？んっ！スピード上げていくぞ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_09",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あぐぅっ！すごい…布越しになぎさんのあったかいアナルとか…おまんこ感じる…！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ちんぽに集中してるのか？射精我慢だからな」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「は、はい…分かってます…でも…ぐぅうぅっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「なんだ、もう音を上げてるのか？」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_08",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「金玉から精子昇ってきてるんじゃないのか、もっと頑張れ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「尻の割れ目に力を入れて…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「んくぁぁ！？ま、待ってくださいっ！竿っ！持っていかれちゃうっ！」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_07",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ん～？なんだ、竿ごときでわめいて、女じゃないんだから笑」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「まぁ私には到底分からない感覚だけどな笑」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_08",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「んあぁ！ちんぽ圧迫されて…おなか…苦しいっ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「このまま尻で押しつぶしてもいいぞ笑」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG27_Siri_09",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「ちんぽ潰されたらどうなるんだろうな、まぁ女の私にはわからん苦しみだが笑」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「くぅ…なぎさん…も、もう…ダメそうです…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":0,"parameters":["「なんだよ、もう少し根性見せると思ったんだがな」"]},{"code":231,"indent":0,"par