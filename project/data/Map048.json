":1,"parameters":["\\SE[1]「こんな夜遅くに出歩いて、夜這いがかけられそうな家でも探していたのか？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\\SE[2]「そ、そんな！誤解ですから！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\\SE[2]「俺はただ寝つきが悪くて、それで夜の村は静かだし、体も動かせればって…」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[5]「体を動かす？嫌がる村の女の子に腰振って運動か？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\\SE[2]「ど、どうしてそうなるんですか！俺はただ…」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[9]「はぁ…お前さ、この間の事があってまだそんな不審な動きをするのか？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[9]「私が注意した事、全然聞いてないみたいだな」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[4]「それともこの間の快感が忘れられなくてわざと変な動きをしてるのか？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\\SE[2]「ち、違います！誤解ですから！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[8]「今度という今度は注意じゃ済まさないぞ」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\\SE[2]「な…何を…あぁっ！止めて下さい！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["\\SE[8]「この変態のドM野郎が、覚悟しろよ」"]},{"code":357,"indent":1,"parameters":["TRP_SkitMZ","clear","[退出]clear/全キャラの非表示",{"wait":"true"}]},{"code":657,"indent":1,"parameters":["ウェイト = true"]},{"code":108,"indent":1,"parameters":["服を着替えたことが表現できるSE（脱がされるため）"]},{"code":250,"indent":1,"parameters":[{"name":"se/kinuzure3","volume":100,"pitch":100,"pan":0}]},{"code":108,"indent":1,"parameters":["HCGパート"]},{"code":221,"indent":1,"parameters":[]},{"code":118,"indent":1,"parameters":["回想中"]},{"code":117,"indent":1,"parameters":[8]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_1",0,0,0,0,100,100,255,0]},{"code":222,"indent":1,"parameters":[]},{"code":357,"indent":1,"parameters":["TRP_SkitMZ","end","スキット終了",{"noAnimation":"false"}]},{"code":657,"indent":1,"parameters":["瞬時に非表示 = false"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「あのさ、雑魚ちんぽ程暇じゃないんだぞ、私も」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「いちいち何をしていたか問答を繰り返す時間はないんだ」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「だから…今回は少しお灸を据えないといけないな」"]},{"code":357,"indent":1,"parameters":["TRP_SkitMZ","end","スキット終了",{"noAnimation":"false"}]},{"code":657,"indent":1,"parameters":["瞬時に非表示 = false"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「や…やめて…」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_3",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「女性に簡単に服をはぎ取られて股開かれるなんて男として終わってるな笑」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_2",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「夜這いを画策するなんて、脳みそまでちんぽになってるみたいだからな」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「思い切り踏みつぶして今回こそ去勢だな」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「だ、だめです！お願いですから！やめてください！」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_1",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「おいおい、止めてって言いながらもうビクビク勃起しだしてるぞ笑」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「期待しすぎじゃないのか？」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_5",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「あぐっ！ん”ん”ん”ん”ん”っ！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「おら、ぐりぐりだぞ、お前が待ち望んでたやつだな笑」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_6",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「電気あんまでタマつぶしてやるぞ、コラ、足閉じるな」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「あぐぅっ！これ…刺激強いですからぁ！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「暴れるなって、変態マゾちんぽくんにはこれくらい強いお仕置きじゃないとな」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「どんどん硬くなってきてるじゃないか、足の裏から勃起の感覚伝わってくるぞ」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_7",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「棒をぐりぐり～」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「あがっ！だめぇっ！」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_10",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「甘い雌声出しながら何がダメだ笑お望みのタマもぐりぐり～」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「んぎぃぃっ！ぐるじ…づぶれるぅ…」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_8",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「つぶしてほしいんだろ笑」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_7",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「だがこれじゃただのマゾへのご褒美になってしまうからな？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「深夜徘徊するようなこそこそする変態マゾ野郎には…」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「もっと強めの電気あんまが必要だなっ！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「ごおっ！マジで…つぶれ…がぁっ！」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_7",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「よだれ垂らして汚い奴だな笑それに…ちんぽの先っぽからもダラダラよだれ垂れてるぞ？」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_9",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「まったく、どこまで変態なんだ…よっ！」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「んぐぅっ！？もう蹴ってるっ！それ蹴ってますから…ごぁっ！」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_8",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"Bow4","volume":50,"pitch":150,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「ははは！つぶれたカエルみたいな声出てるな？」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"なぎ"]},{"code":401,"indent":1,"parameters":["「左右のタマが入れ替わるくらい激しく振動させてやるよ」"]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["「おごぉぉっ！らめ…意識…飛ぶ…」"]},{"code":231,"indent":1,"parameters":[1,"HCG/HCG12_DenkiAnma_13",0,0,0,0,100,100,255,0]},{"code":108,"indent":1,"parameters":["射精音SE"]},{"code":250,"indent":1,"param