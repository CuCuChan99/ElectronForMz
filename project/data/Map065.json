"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「お兄さんの事ずっと信じてたんだよ？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「それに、私の事選んでくれるように…恥神様にたっくさんお願いしたんだ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[2]「ちゃんと私のお願い聞き入れてくれたみたいだね」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[4]「…選んでくれて…ありがとう」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「…うん、俺は…ことねちゃんの事が好きだ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「何度儀式をやり直しても…何回でもことねちゃんの事を選ぶよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[2]「ふふ、嬉しい…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「でも…どうしてこの小屋で会う事にしたの？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「だってここはお兄さんと…いおりちゃんが過ごした場所でしょ？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「これからはずっと私といるのに、他の女と過ごす思い出のある場所があるなんて考えられない」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「だからね…？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[2]「いおりちゃんの全部を、私で上書きするの」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「ことねちゃん…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「もうお兄さんはずぅっとこの村で私と過ごすんだよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「他の事なんて何も考えなくてもいい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「1日、1時間、1分、1秒…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[2]「お兄さんの心も体も、ぜーんぶことねで埋め尽くしてあげるね」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「うん…ことねちゃんで満たされたい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[2]「ふふっ、えらいえらい、やっぱり私のお兄さんだね」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「ほら、そんなところに立ってないで？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["\\SE[1]「こっちに来て…私と1つになろ…？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\SE[2]「はい…ことねちゃん…愛してる…」"]},{"code":357,"indent":0,"parameters":["TRP_SkitMZ","clear","[退出]clear/全キャラの非表示",{"wait":"true"}]},{"code":657,"indent":0,"parameters":["ウェイト = true"]},{"code":108,"indent":0,"parameters":["HCGパート"]},{"code":221,"indent":0,"parameters":[]},{"code":118,"indent":0,"parameters":["回想中"]},{"code":117,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_03",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":357,"indent":0,"parameters":["TRP_SkitMZ","end","スキット終了",{"noAnimation":"false"}]},{"code":657,"indent":0,"parameters":["瞬時に非表示 = false"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「くす、もう勃起しちゃってる」"]},{"code":357,"indent":0,"parameters":["TRP_SkitMZ","end","スキット終了",{"noAnimation":"false"}]},{"code":657,"indent":0,"parameters":["瞬時に非表示 = false"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「ご、ごめ…でもことねちゃんに挿入できるって思ったら…」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_01",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「もう我慢汁もダラダラ出てるよ？早くおまんこしたいって言ってるみたい」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「うん、ことねちゃんと繋がりたくてもう…我慢できないよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あ、でも前戯は…」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_02",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「そんなのいらないよ、だって私もお兄さんのおちんちん入れたいってずっと思ってたもん」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「そしたら…おまんこもぐちょぐちょになっちゃったの」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「嬉しい…そ、それじゃ入れるよ？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「くすくす、ちゃんと上手にできるかなぁ？」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_05",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「おちんちん我慢できなくて、入れた瞬間にお漏らししちゃうんじゃない？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「そ、そんな事ないから！ことねちゃんを気持ちよくするって約束するよ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_03",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「ふふ、分かった…それじゃ…ん、来てぇ…？」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_09",0,0,0,0,100,100,255,0]},{"code":108,"indent":0,"parameters":["スローなピストンSE"]},{"code":250,"indent":0,"parameters":[{"name":"se/Wet_sound/1_slow_piston","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「うわっ…ことねちゃ…あ…や、ヤバいよぉ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「ホントに中ぬるぬるになってる…くぅ…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ことね"]},{"code":401,"indent":0,"parameters":["「ん…♡あぁんっ！お兄さんの…おっきいよぉ…」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG28_Taimen_11",0,0,0,0,100,100,255,0]},{"code":101,"