0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「本当にそう思っているのかしら…自分のここ、ごらんなさい？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「な、何を言って…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「くす…もう半勃ちになってる、これから何をされるか期待が大きいんじゃない？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「そ、そんな事ない！この村の陰謀を暴くために俺は…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「そう？ならその覚悟を確かめさせてもらおうかしら」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG30_HajigamiFella_06",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「な、何を言って…ん”っ！？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あぁぁ！？」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG30_HajigamiFella_09",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「ふふ、どうしたの？軽く亀頭を咥えただけでそんな反応して…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「まぁいいわ、しっかり我慢して頂戴？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「そうじゃないと余興に招いた意味がないわ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あぐっ！？くぅ…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(なんだ…この快感は…！)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(髪の毛が蛇になってて…それでちんぽを咥えられてる)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(人間の口と全然違う快感で…これは…や、ヤバい！)"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG30_HajigamiFella_16",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「あ”っ！やめ…ろ…変なもので咥えるなぁ…あ”んっ♡」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「ふふ、甘い雌声出しながら何をやめろですって？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「でも気持ちいいでしょう、人間の口淫では感じられない快感よ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「アナコンダフェラとはまさにこのことね」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG30_HajigamiFella_08",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「んぐぅぅっ！お、奥ぅ…だめぇ…」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「どうしちゃったの？村の陰謀を食い止めるんでしょう」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「腰を浮かせてる場合じゃないわよ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「あらあら、乳首の自己主張が強いわ」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「僕も混ぜて～って言ってるみたい、ちゃんと仲間に加えてあげましょうね」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「はぐぅんっ！あ”っ！これ…しゅごいぃ…っ！」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「蛇の舌先はかなり早く動くのよ」"]},{"code":231,"indent":0,"parameters":[1,"HCG/HCG30_HajigamiFella_22",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"ハジヒメ"]},{"code":401,"indent":0,"parameters":["「蛇舌で乳首甘く転がされるの、好きでしょう？」"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(ま、まずい…頭がぼーっとしてきてる)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(この快感をずっと続けてたら…何も考えられなくなるっ！)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["(早く逃げないと…でも…腰に蛇が巻き付いていて逃げられない！)"]},{"code":231,"indent":0,"parameters":[1,"HCG/HC